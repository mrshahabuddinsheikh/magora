# Copy to apps/web/.env.local on the server.
NEXT_PUBLIC_API_URL=https://api.yourdomain.pk/api/v1
API_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_SITE_URL=https://yourdomain.pk
NEXT_PUBLIC_STORE_NAME=Magora
NEXT_PUBLIC_WHATSAPP=923xxxxxxxxx
# same value as WEB_REVALIDATE_SECRET in apps/api/.env
REVALIDATE_SECRET=

# Optional — ads & visitor stats (leave empty to keep them off)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
