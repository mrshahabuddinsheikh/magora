# Copy to apps/api/.env on the server and fill in every value.
NODE_ENV=production
PORT=4000
HOST=127.0.0.1
DATABASE_URL=file:./data/store.db

# 64 random characters — run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
WEB_REVALIDATE_SECRET=

CORS_ORIGINS=https://yourdomain.pk,https://www.yourdomain.pk
PUBLIC_WEB_URL=https://yourdomain.pk
PUBLIC_API_URL=https://api.yourdomain.pk
WEB_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
UPLOAD_DIR=./uploads

STORE_NAME=Magora
SUPPORT_PHONE=+92 3xx xxxxxxx
SUPPORT_WHATSAPP=923xxxxxxxxx
SUPPORT_EMAIL=support@yourdomain.pk
# printed on parcel labels as the return address
STORE_ADDRESS=Shop #, Street, Area, Karachi
# can customers open the parcel before paying? (printed on labels; change per order in admin)
OPEN_PARCEL_DEFAULT=true

# First admin (used once by `npm run db:seed`). 10+ characters.
ADMIN_EMAIL=you@yourdomain.pk
ADMIN_PASSWORD=

JAZZCASH_ENABLED=false
EASYPAISA_ENABLED=false
CARD_ENABLED=false
# REVIEW_THANKS_COUPON=THANKYOU100   # (optional) code shown after a customer leaves a review — create it in Admin → Coupons first
