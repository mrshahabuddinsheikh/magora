# ── API server ──
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Local SQLite file (zero setup). For production use Turso/libSQL:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/store.db

# Long random string — generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production-please

# Comma separated list of allowed origins (web site). Mobile apps don't need CORS.
CORS_ORIGINS=http://localhost:3000

# Website URL (used in emails / payment redirects)
PUBLIC_WEB_URL=http://localhost:3000
# After admin edits the API pings the website so cached pages refresh instantly
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
WEB_REVALIDATE_SECRET=dev-revalidate-secret

# Store info
STORE_NAME=Magora
SUPPORT_PHONE=+92 300 0000000
SUPPORT_WHATSAPP=923000000000
SUPPORT_EMAIL=support@example.com

# First admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@magora.pk
ADMIN_PASSWORD=ChangeMe@123

# ── Online payments (later) ── set ENABLED=true + credentials to switch on
JAZZCASH_ENABLED=false
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX=true

EASYPAISA_ENABLED=false
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_SANDBOX=true

CARD_ENABLED=false
CARD_PROVIDER=payfast
CARD_MERCHANT_ID=
CARD_SECRET=

# Public address of this API (links to uploaded customer photos)
PUBLIC_API_URL=http://localhost:4000
# Where customer photos are saved (use S3/R2 in production)
UPLOAD_DIR=./uploads
