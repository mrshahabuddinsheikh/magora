{
  "name": "@magora/api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reviews": "tsx src/db/seed-reviews.ts",
    "admin:password": "tsx src/db/admin-password.ts",
    "db:backup": "tsx src/db/backup.ts",
    "db:seed:bulk": "tsx src/db/seed.ts --bulk=5000",
    "security:audit": "tsx src/scripts/redteam-audit.ts",
    "setup": "npm run db:migrate && npm run db:seed && npm run db:reviews"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@libsql/client": "^0.18.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "draco3dgltf": "1.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "lru-cache": "^11.5.3",
    "meshoptimizer": "^0.22.0",
    "nanoid": "^6.0.2",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typebox": "^1.4.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  }
}
