{
  "name": "magora-store",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "MagSafe case store — Next.js storefront + versioned Node.js API",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @magora/api\" \"npm run dev -w @magora/web\"",
    "dev:api": "npm run dev -w @magora/api",
    "dev:web": "npm run dev -w @magora/web",
    "build": "node scripts/build.mjs",
    "start": "node server.js",
    "typecheck": "npm run typecheck -w @magora/api && npm run typecheck -w @magora/web",
    "package:staging": "node scripts/prepare-staging.mjs",
    "package:zip": "node scripts/package-upload.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.5",
    "dotenv": "^18.0.10",
    "draco3dgltf": "1.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "leaflet": "^1.9.4",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.72.0",
    "meshoptimizer": "^0.22.0",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typebox": "^1.4.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
